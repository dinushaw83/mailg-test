        "expected": "Please review this invoice discrepancy"
      },
      {
        "title": "Forwarded email has Sent label",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Fwd: Invoice mismatch - URGENT')].labels",
        "expected": ["Sent"],
        "options": {"mode": "some"}
      },
      {
        "title": "Original email is snoozed",
        "operator": "ARRAY_CONTAINS",
