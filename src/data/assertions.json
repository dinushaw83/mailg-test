{
  "MAILG-COMPOSE-SEND-001": {
    "prompt": "Compose a new email addressed to david.kim@acelogistics.com, cc: sarah.johnson@northwindretail.com, bcc: compliance@company.com. Subject should be 'Q3 Financial Forecast Submission'. The message body: 'Hi David, please find attached the updated Q3 financial forecast. We've incorporated the recent adjustments in marketing spend and logistics costs. Kindly review and confirm if these align with your records. Best, Laura'. Send it immediately.",
    "isPrimary": true,
    "assertions": [
      {
        "title": "Sent email exists with correct subject",
        "operator": "ARRAY_CONTAINS",
        "path": "emails",
        "expected": [{"subject": "Q3 Financial Forecast Submission"}],
        "options": {"mode": "some", "matchBy": "key", "key": "subject"}
      },
      {
        "title": "Email has correct TO recipient",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].to",
        "expected": ["david.kim@acelogistics.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Email has correct CC recipient",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].cc",
        "expected": ["sarah.johnson@northwindretail.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Email has correct BCC recipient",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].bcc",
        "expected": ["compliance@company.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Email body contains key content",
        "operator": "STRING_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].body",
        "expected": "Q3 financial forecast",
        "options": {"caseInsensitive": true}
      },
      {
        "title": "Email has Sent label",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].labels",
        "expected": ["Sent"],
        "options": {"mode": "some"}
      },
      {
        "title": "Email has timestamp",
        "operator": "EXISTS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].timestamp"
      },
      {
        "title": "Email is from logged in user",
        "operator": "STRING_MATCH",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].from.email",
        "expected": "john.doe@example.com",
        "options": {"caseInsensitive": true}
      }
    ]
  },
  "MAILG-REPLY-EMAIL-002": {
    "prompt": "Reply to the email from emma.brown@techstream.com with subject 'Invoice mismatch - URGENT'.",
    "isPrimary": true,
    "assertions": [
      {
        "title": "Reply email exists",
        "operator": "ARRAY_CONTAINS",
        "path": "emails",
        "expected": [{"subject": "Re: Invoice mismatch - URGENT"}],
        "options": {"mode": "some", "matchBy": "key", "key": "subject"}
      },
      {
        "title": "Reply sent to emma.brown",
        "operator": "ARRAY_CONTAINS",
        "path": "emails",
        "expected": [{"to": ["emma.brown@techstream.com"]}],
        "options": {"mode": "some", "matchBy": "key", "key": "to"}
      },
      {
        "title": "Reply has Sent label",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Re: Invoice mismatch - URGENT')].labels",
        "expected": ["Sent"],
        "options": {"mode": "some"}
      },
      {
        "title": "Reply is from logged in user",
        "operator": "STRING_MATCH",
        "path": "emails[?(@.subject=='Re: Invoice mismatch - URGENT')].from.email",
        "expected": "john.doe@example.com",
        "options": {"caseInsensitive": true}
      },
      {
        "title": "Reply has timestamp",
        "operator": "EXISTS",
        "path": "emails[?(@.subject=='Re: Invoice mismatch - URGENT')].timestamp"
      }
    ]
  },
  "MAILG-ORGANIZE-LABELS-003": {
    "prompt": "Star the email with subject 'Tracking update for Order #56789' and mark it as important.",
    "isPrimary": true,
    "assertions": [
      {
        "title": "Tracking email is starred",
        "operator": "JSON_MATCH",
        "path": "emails[?(@.subject=='Tracking update for Order #56789')].starred",
        "expected": true
      },
      {
        "title": "Tracking email is marked important",
        "operator": "JSON_MATCH",
        "path": "emails[?(@.subject=='Tracking update for Order #56789')].important",
        "expected": true
      }
    ]
  },
  "MAILG-DRAFT-SCHEDULE-004": {
    "prompt": "Create a draft email to jane.doe@northwindretail.com with subject 'Draft: Proposal Outline' and body 'Dear Jane, I wanted to outline the key points for our upcoming proposal meeting.'. Save it as a draft.",
    "isPrimary": true,
    "assertions": [
      {
        "title": "Draft email exists",
        "operator": "ARRAY_CONTAINS",
        "path": "emails",
        "expected": [{"subject": "Draft: Proposal Outline"}],
        "options": {"mode": "some", "matchBy": "key", "key": "subject"}
      },
      {
        "title": "Draft addressed to jane.doe",
        "operator": "ARRAY_CONTAINS",
        "path": "emails",
        "expected": [{"to": ["jane.doe@northwindretail.com"]}],
        "options": {"mode": "some", "matchBy": "key", "key": "to"}
      },
      {
        "title": "Draft has Drafts label",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Draft: Proposal Outline')].labels",
        "expected": ["Drafts"],
        "options": {"mode": "some"}
      },
      {
        "title": "Draft body contains key content",
        "operator": "STRING_CONTAINS",
        "path": "emails[?(@.subject=='Draft: Proposal Outline')].body",
        "expected": "proposal",
        "options": {"caseInsensitive": true}
      },
      {
        "title": "Draft has timestamp",
        "operator": "EXISTS",
        "path": "emails[?(@.subject=='Draft: Proposal Outline')].timestamp"
      }
    ]
  },
