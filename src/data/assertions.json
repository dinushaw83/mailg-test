{
  "MAILG-COMPOSE-SEND-001": {
    "prompt": "Compose a new email addressed to david.kim@acelogistics.com, cc: sarah.johnson@northwindretail.com, bcc: compliance@company.com. Subject should be 'Q3 Financial Forecast Submission'. The message body: 'Hi David, please find attached the updated Q3 financial forecast. We've incorporated the recent adjustments in marketing spend and logistics costs. Kindly review and confirm if these align with your records. Best, Laura'. Send it immediately. After sending, star the sent email and mark it as important.",
    "isPrimary": true,
    "assertions": [
      {
        "title": "Sent email exists with correct subject",
        "operator": "ARRAY_CONTAINS",
        "path": "emails",
        "expected": [{"subject": "Q3 Financial Forecast Submission"}],
        "options": {"mode": "some", "matchBy": "key", "key": "subject"}
      },
      {
        "title": "Email has correct TO recipient",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].to",
        "expected": ["david.kim@acelogistics.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Email has correct CC recipient",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].cc",
        "expected": ["sarah.johnson@northwindretail.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Email has correct BCC recipient",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].bcc",
        "expected": ["compliance@company.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Email body contains greeting",
        "operator": "STRING_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].body",
        "expected": "Hi David",
        "options": {"caseInsensitive": true}
      },
      {
        "title": "Email body contains main content",
        "operator": "STRING_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].body",
        "expected": "Q3 financial forecast",
        "options": {"caseInsensitive": true}
      },
      {
        "title": "Email body contains sign-off",
        "operator": "STRING_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].body",
        "expected": "Best",
        "options": {"caseInsensitive": true}
      },
      {
        "title": "Email has Sent label",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].labels",
        "expected": ["Sent"],
        "options": {"mode": "some"}
      },
      {
        "title": "Sent email is starred",
        "operator": "JSON_MATCH",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].starred",
        "expected": true
      },
      {
        "title": "Sent email is marked important",
        "operator": "JSON_MATCH",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].important",
        "expected": true
      },
      {
        "title": "Email is from logged in user",
        "operator": "STRING_MATCH",
        "path": "emails[?(@.subject=='Q3 Financial Forecast Submission')].from.email",
        "expected": "john.doe@example.com",
        "options": {"caseInsensitive": true}
      }
    ]
  },
  "MAILG-REPLY-EMAIL-002": {
    "prompt": "Reply to the email from emma.brown@techstream.com with subject 'Invoice mismatch - URGENT'. Add accounting@company.com in CC. Your reply: 'Hi Emma, thank you for flagging this issue. I have looped in our accounting team to investigate. We will get back to you within 24 hours. Regards, John'. After sending, add labels 'Accounting' and 'Urgent-Review' to the original email, and mark your reply as important.",
    "isPrimary": true,
    "assertions": [
      {
        "title": "Reply email exists",
        "operator": "ARRAY_CONTAINS",
        "path": "emails",
        "expected": [{"subject": "Re: Invoice mismatch - URGENT"}],
        "options": {"mode": "some", "matchBy": "key", "key": "subject"}
      },
      {
        "title": "Reply sent to emma.brown",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Re: Invoice mismatch - URGENT')].to",
        "expected": ["emma.brown@techstream.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Reply has CC to accounting",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Re: Invoice mismatch - URGENT')].cc",
        "expected": ["accounting@company.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Reply body contains thank you",
        "operator": "STRING_CONTAINS",
        "path": "emails[?(@.subject=='Re: Invoice mismatch - URGENT')].body",
        "expected": "thank you for flagging",
        "options": {"caseInsensitive": true}
      },
      {
        "title": "Reply body mentions accounting team",
        "operator": "STRING_CONTAINS",
        "path": "emails[?(@.subject=='Re: Invoice mismatch - URGENT')].body",
        "expected": "accounting team",
        "options": {"caseInsensitive": true}
      },
      {
        "title": "Reply body mentions timeframe",
        "operator": "STRING_CONTAINS",
        "path": "emails[?(@.subject=='Re: Invoice mismatch - URGENT')].body",
        "expected": "24 hours",
        "options": {"caseInsensitive": true}
      },
      {
        "title": "Reply has Sent label",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Re: Invoice mismatch - URGENT')].labels",
        "expected": ["Sent"],
        "options": {"mode": "some"}
      },
      {
        "title": "Reply is from logged in user",
        "operator": "STRING_MATCH",
        "path": "emails[?(@.subject=='Re: Invoice mismatch - URGENT')].from.email",
        "expected": "john.doe@example.com",
        "options": {"caseInsensitive": true}
      },
      {
        "title": "Original email has Accounting label",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Invoice mismatch - URGENT')].labels",
        "expected": ["Accounting"],
        "options": {"mode": "some"}
      },
      {
        "title": "Original email has Urgent-Review label",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Invoice mismatch - URGENT')].labels",
        "expected": ["Urgent-Review"],
        "options": {"mode": "some"}
      },
      {
        "title": "Reply is marked important",
        "operator": "JSON_MATCH",
        "path": "emails[?(@.subject=='Re: Invoice mismatch - URGENT')].important",
        "expected": true
      }
    ]
  },
  "MAILG-ORGANIZE-LABELS-003": {
    "prompt": "Go to Promotions tab. Delete the Nike email 'End of season sale — up to 40% off' by moving it to Trash. Then star the Pinterest email 'Ideas you might love — Minimal home office' and mark it as important.",
    "isPrimary": true,
    "assertions": [
      {
        "title": "Nike email moved to Trash",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='👟 End of season sale — up to 40% off')].labels",
        "expected": ["Trash"],
        "options": {"mode": "some"}
      },
      {
        "title": "Pinterest email is starred",
        "operator": "JSON_MATCH",
        "path": "emails[?(@.subject=='Ideas you might love — Minimal home office')].starred",
        "expected": true
      },
      {
        "title": "Pinterest email is marked important",
        "operator": "JSON_MATCH",
        "path": "emails[?(@.subject=='Ideas you might love — Minimal home office')].important",
        "expected": true
      }
    ]
  },
  "MAILG-DRAFT-SCHEDULE-004": {
    "prompt": "Compose an email to jane.doe@northwindretail.com with CC to marketing@northwindretail.com. Subject: 'Proposal Outline'. Body: 'Dear Jane, I wanted to outline the key points for our upcoming proposal meeting. Best regards.'. Schedule it to send tomorrow morning. Then go to the Scheduled folder, find the email, and star it.",
    "isPrimary": true,
    "assertions": [
      {
        "title": "Scheduled email exists with correct subject",
        "operator": "ARRAY_CONTAINS",
        "path": "emails",
        "expected": [{"subject": "Proposal Outline"}],
        "options": {"mode": "some", "matchBy": "key", "key": "subject"}
      },
      {
        "title": "Email has correct TO recipient",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Proposal Outline')].to",
        "expected": ["jane.doe@northwindretail.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Email has CC recipient",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Proposal Outline')].cc",
        "expected": ["marketing@northwindretail.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Email has Scheduled label",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Proposal Outline')].labels",
        "expected": ["Scheduled"],
        "options": {"mode": "some"}
      },
      {
        "title": "Email has scheduledDate property",
        "operator": "EXISTS",
        "path": "emails[?(@.subject=='Proposal Outline')].scheduledDate"
      },
      {
        "title": "Email body contains proposal content",
        "operator": "STRING_CONTAINS",
        "path": "emails[?(@.subject=='Proposal Outline')].body",
        "expected": "proposal",
        "options": {"caseInsensitive": true}
      },
      {
        "title": "Scheduled email is starred",
        "operator": "JSON_MATCH",
        "path": "emails[?(@.subject=='Proposal Outline')].starred",
        "expected": true
      }
    ]
  },
  "MAILG-FORWARD-EMAIL-005": {
    "prompt": "Forward the email with subject 'Invoice mismatch - URGENT' to manager@company.com with CC to cfo@company.com. Add note 'Please review this invoice discrepancy'. After sending, snooze the original email until next week.",
    "isPrimary": true,
    "assertions": [
      {
        "title": "Forwarded email exists with correct subject",
        "operator": "ARRAY_CONTAINS",
        "path": "emails",
        "expected": [{"subject": "Fwd: Invoice mismatch - URGENT"}],
        "options": {"mode": "some", "matchBy": "key", "key": "subject"}
      },
      {
        "title": "Forwarded email TO is manager@company.com",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Fwd: Invoice mismatch - URGENT')].to",
        "expected": ["manager@company.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Forwarded email CC is cfo@company.com",
        "operator": "ARRAY_CONTAINS",
        "path": "emails[?(@.subject=='Fwd: Invoice mismatch - URGENT')].cc",
        "expected": ["cfo@company.com"],
        "options": {"mode": "some"}
      },
      {
        "title": "Forwarded email body contains note",
        "operator": "STRING_CONTAINS",
