# =============================================================================
# MailG Production Environment Variables Template
# =============================================================================
# 
# IMPORTANT: Copy this file to .env.production on your VM and fill in the
# actual values. NEVER commit the actual .env.production file with real
# secrets to git.
#
# Usage: cp env.production.template .env.production
#        Then edit .env.production with your actual values
#
# Generate secure values:
#   JWT_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   POSTGRES_PASSWORD: openssl rand -base64 32
#
# =============================================================================

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_ZONE=us-central1-a

# Container Registry Configuration
# For GCP Artifact Registry: REGION-docker.pkg.dev/PROJECT_ID/REPO_NAME
# For Docker Hub: docker.io/USERNAME
# For GHCR: ghcr.io/OWNER
CONTAINER_REGISTRY_URL=gcr.io/${GCP_PROJECT_ID}
BACKEND_IMAGE=${CONTAINER_REGISTRY_URL}/mailg-backend:latest
FRONTEND_IMAGE=${CONTAINER_REGISTRY_URL}/mailg-frontend:latest

# Database Configuration
POSTGRES_USER=mailg
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=postgres
POSTGRES_ADMIN_DB=postgres
POSTGRES_TEMPLATE_DB=mailg_seed
POSTGRES_RUN_DB_PREFIX=mailg_
POSTGRES_MAX_CONNECTIONS=1000

# PostgreSQL Performance Tuning (adjust based on VM resources)
# For 4 vCPU / 16GB RAM VM:
POSTGRES_SHARED_BUFFERS=4GB
POSTGRES_EFFECTIVE_CACHE_SIZE=12GB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_IO_CONCURRENCY=200
POSTGRES_MAX_WORKERS=4
POSTGRES_MAX_PARALLEL_WORKERS=4
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=2
POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=2

# Application Configuration
DEVELOPMENT_MODE=false
UVICORN_WORKERS=1

# JWT Configuration
# IMPORTANT: Generate a secure random value for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM_VALUE
JWT_ACCESS_TOKEN_TTL_SECONDS=86400

# OpenTelemetry Configuration
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=mailg-backend

# Prometheus Configuration
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_RETENTION=30d

# Frontend Configuration
VITE_RUN_MODE=localstorage
VITE_ENABLE_INSTRUMENTATION=false
VITE_OTEL_COLLECTOR_URL=http://localhost:4318

# Port Configuration
POSTGRES_EXTERNAL_PORT=5436
BACKEND_EXTERNAL_PORT=8766
FRONTEND_EXTERNAL_PORT=3002
PROMETHEUS_EXTERNAL_PORT=9090
GRAFANA_EXTERNAL_PORT=3000
CADVISOR_EXTERNAL_PORT=8090
OTEL_PROMETHEUS_PORT=9465

# Grafana Configuration
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
GF_SERVER_ROOT_URL=http://localhost:3000
GF_VIEWER_PASSWORD=readonly

# =============================================================================
# Security Notes:
# =============================================================================
# 1. All passwords and secrets must be strong, random values
# 2. Never commit this file with real values to git
# 3. Use GCP Secret Manager for sensitive values in production (optional)
# 4. Rotate secrets regularly
# 5. Use least privilege IAM roles for service accounts
# =============================================================================

